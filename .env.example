DATABASE_URL=postgresql+asyncpg://weather:weather@localhost:5432/weather
# Signs the login tokens. Use a long random value outside local development.
JWT_SECRET=dev-only-secret-change-me-in-production
# JSON list of browser origins allowed to call the API.
CORS_ORIGINS=[]

# Host ports for docker compose, in case the defaults are taken.
DB_PORT=5432
API_PORT=8000
